{
  "name": "webhook-delivery-engine",
  "version": "1.0.0",
  "description": "Embeddable Node.js webhook delivery engine with persistent retries.",
  "license": "MIT",
  "repository": "github:hamidjavadi/webhook-delivery-engine",
  "keywords": [
    "webhook",
    "webhook-delivery",
    "webhook-retry",
    "delivery",
    "event-delivery",
    "retry",
    "idempotency",
    "queue",
    "sqlite",
    "nodejs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/storage/migrations/sql', 'dist/src/storage/migrations/sql', { recursive: true });\"",
    "test": "vitest run",
    "benchmark:ingestion": "tsx scripts/benchmark-ingestion.ts",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.20.1",
    "node-gyp": "^13.1.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "safe-buffer": "npm:@socketregistry/safe-buffer@^1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
